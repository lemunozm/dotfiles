[user]
	email = lemunozm@gmail.com
	name = lemunozm
	signingkey = EFFAB5F94B702FA9
[pull]
	ff = only
[fetch]
    prune = true
[rerere]
	enabled = true
	# Replay recorded resolutions, but keep the path unmerged so it must be
	# `git add`ed on purpose. Guards against stale resolutions slipping through.
	autoUpdate = false
[core]
    editor = nvim
	pager = nvimpager -p
	excludesFile = ~/.gitignore
	hooksPath = ~/.config/git/hooks
[commit]
	gpgSign = true
